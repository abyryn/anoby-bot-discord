# ===========================================
#  Anobystore Discord AI Bot - Dokploy Deploy
# ===========================================

# --- WAJIB DIISI ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GEMINI_API_KEY=

# --- MODEL AI (Default: gemini-3.6-flash) ---
GEMINI_MODEL=gemini-3.6-flash

# --- SPOTIFY (Opsional, untuk playlist/album berkecepatan tinggi) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- OPSIONAL ---
DISCORD_GUILD_ID=
BOT_PREFIX=A!
BOT_OWNER_ID=

# --- AI CONFIG ---
MAX_AI_CONTEXT=10
AI_COOLDOWN=5

# --- QUIZ CONFIG ---
QUIZ_DURATION=20
QUIZ_POINTS=100

# --- DATABASE (otomatis dari docker-compose, jangan diubah) ---
# DATABASE_URL=postgresql://anobystore:anobystore_secret@postgres:5432/anobystore_bot?schema=public

# --- LAVALINK (otomatis dari docker-compose, jangan diubah) ---
# LAVALINK_HOST=lavalink
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=false
